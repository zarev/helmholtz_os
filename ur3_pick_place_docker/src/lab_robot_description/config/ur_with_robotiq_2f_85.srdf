<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic Robot Description Format (SRDF) for UR + Robotiq 2F-85 system.
  Gripper joints status:
  - gripper_finger_joint              : actuated (left outer knuckle, master)
  - gripper_right_outer_knuckle_joint : actuated (driven in sync, no mimic support)
  - *_outer_finger_joint              : fixed
  - *_inner_knuckle_joint             : fixed (mimic not supported in Gazebo Harmonic)
  - *_inner_finger_joint              : fixed (mimic not supported in Gazebo Harmonic)
  - *_inner_finger_pad_joint          : fixed
-->
<robot name="ur_with_robotiq_2f_85">

  <!-- ══════════════════════════════════════════════
       PLANNING GROUPS
       ══════════════════════════════════════════════ -->

  <!-- Arm: 6-DOF kinematic chain from world → tool0 -->
  <group name="arm">
    <chain base_link="world" tip_link="tool0"/>
  </group>

  <!-- Gripper: both actuated joints -->
  <group name="gripper">
    <joint name="gripper_finger_joint"/>
    <joint name="gripper_right_outer_knuckle_joint"/>
  </group>

  <!-- Combined group -->
  <group name="arm_with_gripper">
    <group name="arm"/>
    <group name="gripper"/>
  </group>

  <!-- ══════════════════════════════════════════════
       GROUP STATES
       ══════════════════════════════════════════════ -->

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint"  value="0"/>
    <joint name="shoulder_lift_joint" value="-1.6315"/>
    <joint name="elbow_joint"         value="0"/>
    <joint name="wrist_1_joint"       value="1.8251"/>
    <joint name="wrist_2_joint"       value="0"/>
    <joint name="wrist_3_joint"       value="1.2844"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="shoulder_pan_joint"  value="0"/>
    <joint name="shoulder_lift_joint" value="-1.6315"/>
    <joint name="elbow_joint"         value="0"/>
    <joint name="wrist_1_joint"       value="1.8251"/>
    <joint name="wrist_2_joint"       value="0"/>
    <joint name="wrist_3_joint"       value="1.2844"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="gripper_finger_joint" value="0.0"/>
    <joint name="gripper_right_outer_knuckle_joint" value="0.0"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="gripper_finger_joint" value="0.8"/>
    <joint name="gripper_right_outer_knuckle_joint" value="0.8"/>
  </group_state>

  <!-- ══════════════════════════════════════════════
       END EFFECTOR
       ══════════════════════════════════════════════ -->
  <end_effector name="gripper" parent_link="tool0" group="gripper" parent_group="arm"/>

  <!-- ══════════════════════════════════════════════
       DISABLE COLLISIONS
       Rules:
       - Adjacent: physically connected by a joint (always disabled)
       - Never:    geometry makes contact geometrically impossible
       - (absent): MoveIt actively checks these pairs for self-collision
       ══════════════════════════════════════════════ -->

  <!-- ── Arm chain: adjacent pairs ─────────────────────────────────────── -->
  <disable_collisions link1="base_link_inertia" link2="shoulder_link"   reason="Adjacent"/>
  <disable_collisions link1="shoulder_link"     link2="upper_arm_link"  reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link"    link2="forearm_link"    reason="Adjacent"/>
  <disable_collisions link1="forearm_link"      link2="wrist_1_link"    reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link"      link2="wrist_2_link"    reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link"      link2="wrist_3_link"    reason="Adjacent"/>

  <!-- ── Base link: too far from any distal link to ever collide ────────── -->
  <disable_collisions link1="base_link_inertia" link2="forearm_link"                      reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="wrist_1_link"                      reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="wrist_2_link"                      reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="wrist_3_link"                      reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_robotiq_arg2f_base_link"   reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_left_outer_knuckle"        reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_right_outer_knuckle"       reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_left_outer_finger"         reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_right_outer_finger"        reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_left_inner_knuckle"        reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_right_inner_knuckle"       reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_left_inner_finger"         reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_right_inner_finger"        reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_left_inner_finger_pad"     reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="gripper_right_inner_finger_pad"    reason="Never"/>

  <!-- ── Shoulder link: cannot reach wrist or gripper ──────────────────── -->
  <disable_collisions link1="shoulder_link" link2="forearm_link"                      reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_1_link"                      reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_2_link"                      reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_3_link"                      reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_robotiq_arg2f_base_link"   reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_left_outer_knuckle"        reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_right_outer_knuckle"       reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_left_outer_finger"         reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_right_outer_finger"        reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_left_inner_knuckle"        reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_right_inner_knuckle"       reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_left_inner_finger"         reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_right_inner_finger"        reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_left_inner_finger_pad"     reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="gripper_right_inner_finger_pad"    reason="Never"/>

  <!-- ── Upper arm: cannot reach wrist or gripper ──────────────────────── -->
  <disable_collisions link1="upper_arm_link" link2="wrist_1_link"                      reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_2_link"                      reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_3_link"                      reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_robotiq_arg2f_base_link"   reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_left_outer_knuckle"        reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_right_outer_knuckle"       reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_left_outer_finger"         reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_right_outer_finger"        reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_left_inner_knuckle"        reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_right_inner_knuckle"       reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_left_inner_finger"         reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_right_inner_finger"        reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_left_inner_finger_pad"     reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="gripper_right_inner_finger_pad"    reason="Never"/>

  <!-- ── Forearm: CAN collide with wrist_2/3 in tight configs (left enabled!)
       But forearm CANNOT reach gripper finger/pad links ─────────────────── -->
  <disable_collisions link1="forearm_link" link2="gripper_left_inner_finger"         reason="Never"/>
  <disable_collisions link1="forearm_link" link2="gripper_right_inner_finger"        reason="Never"/>
  <disable_collisions link1="forearm_link" link2="gripper_left_inner_finger_pad"     reason="Never"/>
  <disable_collisions link1="forearm_link" link2="gripper_right_inner_finger_pad"    reason="Never"/>

  <!-- ── Wrist 1: adjacent to forearm, NOT disabled vs wrist_3/gripper ──── -->
  <disable_collisions link1="wrist_1_link" link2="gripper_robotiq_arg2f_base_link"   reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="gripper_left_inner_finger"         reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="gripper_right_inner_finger"        reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="gripper_left_inner_finger_pad"     reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="gripper_right_inner_finger_pad"    reason="Never"/>

  <!-- ── Wrist 2: adjacent to wrist_1 and wrist_3 ─────────────────────── -->
  <disable_collisions link1="wrist_2_link" link2="gripper_robotiq_arg2f_base_link"   reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_left_inner_finger"         reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_right_inner_finger"        reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_left_inner_finger_pad"     reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_right_inner_finger_pad"    reason="Never"/>

  <!-- ── Wrist 3: adjacent pair + close knuckle neighbours ─────────────── -->
  <disable_collisions link1="wrist_3_link" link2="gripper_robotiq_arg2f_base_link"   reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_left_outer_knuckle"        reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_right_outer_knuckle"       reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_left_inner_knuckle"        reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_right_inner_knuckle"       reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_left_inner_finger"         reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_right_inner_finger"        reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_left_inner_finger_pad"     reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_right_inner_finger_pad"    reason="Never"/>

  <!-- ── Gripper base: adjacent to both outer knuckles + inner knuckles ── -->
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_left_outer_knuckle"     reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_right_outer_knuckle"    reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_left_inner_knuckle"     reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_right_inner_knuckle"    reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_left_outer_finger"      reason="Never"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_right_outer_finger"     reason="Never"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_left_inner_finger"      reason="Never"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_right_inner_finger"     reason="Never"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_left_inner_finger_pad"  reason="Never"/>
  <disable_collisions link1="gripper_robotiq_arg2f_base_link" link2="gripper_right_inner_finger_pad" reason="Never"/>

  <!-- ── Left finger chain ──────────────────────────────────────────────── -->
  <disable_collisions link1="gripper_left_outer_knuckle" link2="gripper_left_outer_finger"      reason="Adjacent"/>
  <disable_collisions link1="gripper_left_outer_knuckle" link2="gripper_left_inner_knuckle"     reason="Never"/>
  <disable_collisions link1="gripper_left_outer_knuckle" link2="gripper_left_inner_finger"      reason="Never"/>
  <disable_collisions link1="gripper_left_outer_knuckle" link2="gripper_left_inner_finger_pad"  reason="Never"/>
  <disable_collisions link1="gripper_left_outer_finger"  link2="gripper_left_inner_finger"      reason="Adjacent"/>
  <disable_collisions link1="gripper_left_inner_finger"  link2="gripper_left_inner_finger_pad"  reason="Adjacent"/>
  <disable_collisions link1="gripper_left_inner_knuckle" link2="gripper_left_outer_finger"      reason="Never"/>
  <disable_collisions link1="gripper_left_inner_knuckle" link2="gripper_left_inner_finger"      reason="Never"/>
  <disable_collisions link1="gripper_left_inner_knuckle" link2="gripper_left_inner_finger_pad"  reason="Never"/>

  <!-- ── Right finger chain ─────────────────────────────────────────────── -->
  <disable_collisions link1="gripper_right_outer_knuckle" link2="gripper_right_outer_finger"     reason="Adjacent"/>
  <disable_collisions link1="gripper_right_outer_knuckle" link2="gripper_right_inner_knuckle"    reason="Never"/>
  <disable_collisions link1="gripper_right_outer_knuckle" link2="gripper_right_inner_finger"     reason="Never"/>
  <disable_collisions link1="gripper_right_outer_knuckle" link2="gripper_right_inner_finger_pad" reason="Never"/>
  <disable_collisions link1="gripper_right_outer_finger"  link2="gripper_right_inner_finger"     reason="Adjacent"/>
  <disable_collisions link1="gripper_right_inner_finger"  link2="gripper_right_inner_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="gripper_right_inner_knuckle" link2="gripper_right_outer_finger"     reason="Never"/>
  <disable_collisions link1="gripper_right_inner_knuckle" link2="gripper_right_inner_finger"     reason="Never"/>
  <disable_collisions link1="gripper_right_inner_knuckle" link2="gripper_right_inner_finger_pad" reason="Never"/>

  <!-- ── Cross-side (left vs right): symmetric gripper, inner links never meet ── -->
  <disable_collisions link1="gripper_left_outer_knuckle"  link2="gripper_right_outer_knuckle"    reason="Never"/>
  <disable_collisions link1="gripper_left_inner_knuckle"  link2="gripper_right_inner_knuckle"    reason="Never"/>
  <disable_collisions link1="gripper_left_inner_knuckle"  link2="gripper_right_outer_knuckle"    reason="Never"/>
  <disable_collisions link1="gripper_left_outer_knuckle"  link2="gripper_right_inner_knuckle"    reason="Never"/>
  <disable_collisions link1="gripper_left_inner_finger"   link2="gripper_right_inner_finger"     reason="Never"/>
  <disable_collisions link1="gripper_left_inner_finger"   link2="gripper_right_outer_finger"     reason="Never"/>
  <disable_collisions link1="gripper_left_outer_finger"   link2="gripper_right_inner_finger"     reason="Never"/>
  <disable_collisions link1="gripper_left_outer_finger"   link2="gripper_right_outer_finger"     reason="Never"/>
  <disable_collisions link1="gripper_left_inner_finger_pad"  link2="gripper_right_inner_finger_pad"  reason="Never"/>
  <disable_collisions link1="gripper_left_inner_finger_pad"  link2="gripper_right_outer_finger"      reason="Never"/>
  <disable_collisions link1="gripper_left_outer_finger"      link2="gripper_right_inner_finger_pad"  reason="Never"/>

</robot>
