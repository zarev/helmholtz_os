# Host runtime config for scripts/run_with_gui.sh
# Edit values as needed.

UR_TYPE=ur3
ROS_DOMAIN_ID=0

# Keep RViz headless by default. Set to 1 only when needed.
LAUNCH_RVIZ=0
REQUIRE_GUI=1
RUN_PICK_PLACE_CLIENT=1

USE_WS_OVERLAY=0
SIM_BACKEND=upstream
ARM_ACTION_NAME=/scaled_joint_trajectory_controller/follow_joint_trajectory
IK_GROUP_NAME=ur_manipulator
REQUIRE_GRIPPER=1
WORLD_FILE=/ws/pick_and_place_demo.local.world
POSE_FRAME=base_link

PICK_X=0.35
PICK_Y=0.15
PICK_Z=0.12
PLACE_X=0.35
PLACE_Y=-0.20
PLACE_Z=0.12
